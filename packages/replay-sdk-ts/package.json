{
  "name": "@zaxcoraider/replay-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Replay Solana time-travel debugger",
  "license": "MIT",
  "author": "zaxcoraider",
  "repository": {
    "type": "git",
    "url": "https://github.com/zaxcoraider/replay"
  },
  "homepage": "https://replay-weld.vercel.app/docs/ts-sdk",
  "bugs": {
    "url": "https://github.com/zaxcoraider/replay/issues"
  },
  "keywords": ["solana", "debugger", "replay", "sdk", "blockchain", "developer-tools"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
