# Copy to .env and fill in. Never commit the real .env.

# Required — get from helius.xyz (free tier works for the hackathon)
HELIUS_API_KEY=

# Optional overrides
# REPLAY_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
REPLAY_BIND_ADDR=0.0.0.0:8080
REPLAY_IDL_CACHE_DIR=.replay/idl-cache
REPLAY_SESSION_TTL_SECS=3600
REPLAY_MAX_SESSIONS=100

# Tracing
RUST_LOG=replay_core=debug,replay_api=info,tower_http=info

# Live-network tests (unset for fast local dev)
# REPLAY_LIVE_TESTS=1
